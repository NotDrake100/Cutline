# Server / Cloud Run / Vercel only. Do not commit values.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Prefer gemini-flash-latest or gemini-3.8-flash. Image gen may 429 on free-tier (limit 0); paid/quota may be required. Desk uses the sourced page photo.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PEXELS_API_KEY=
CUTLINE_PUBLIC_URL=https://cutline.dev
CUTLINE_OWNER_KEY=
# CUTLINE_FORCE_DEMO=1
# OAuth redirect to register on each app:
#   {CUTLINE_PUBLIC_URL}/api/oauth/callback/{ig|yt|canva|gmail|drive|slack|telegram|x|tiktok}
IG_APP_ID=
IG_APP_SECRET=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Gmail + Drive (prefer these; YT_CLIENT_* also accepted as the same Google app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=
CANVA_ACCOUNT_ID=
CANVA_ACCOUNT_LABEL=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
