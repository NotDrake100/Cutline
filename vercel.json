{
  "version": 2,
  "build": { "env": { "NODE_VERSION": "20.x" } },
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" },
    { "src": "apps/web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/studio/?", "dest": "/apps/web/studio.html" },
    { "src": "/media/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/apps/web/$1" }
  ]
}
